/lab/*
  X-Robots-Tag: noindex, nofollow
/data/*
  X-Robots-Tag: noindex, nofollow
/login/*
  X-Robots-Tag: noindex, nofollow
/signup/*
  X-Robots-Tag: noindex, nofollow
/reset/*
  X-Robots-Tag: noindex, nofollow
/verify/*
  X-Robots-Tag: noindex, nofollow
/connect/*
  X-Robots-Tag: noindex, nofollow
/oauth/*
  X-Robots-Tag: noindex, nofollow
