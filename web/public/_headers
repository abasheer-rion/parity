# Built files have a hash of their contents in the name, so a copy never goes stale: keep
# them a year (REF-0024). The apps' own built files are private and get the same from the
# middleware (functions/_middleware.ts).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public caching (DEC-0072, src/lib/cachePolicy.ts holds the same values for the middleware).
# Each path gets Cache-Control from one rule only, because Pages joins two matching values
# with a comma. Pages: fresh 10 minutes, then shown at once while a new copy loads, up to
# 3 days. Pictures and icons: a day, then the same. Small hourly data: a minute. Sign-in
# pages: never kept. Every deploy replaces the edge copies, so a deploy is never hidden.
/developers/*
  Cache-Control: public, max-age=600, stale-while-revalidate=259200
/legal/*
  Cache-Control: public, max-age=600, stale-while-revalidate=259200
/learn/*
  Cache-Control: public, max-age=600, stale-while-revalidate=259200
