# Copy to .env.local for local development. All values are public.
# Defaults point at the Parity Supabase project, so these are optional.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sign-in buttons to show, comma separated: google,github,apple,azure (auth/PROVIDERS.md).
VITE_AUTH_PROVIDERS=
# "on" shows passkey sign-in.
VITE_AUTH_PASSKEYS=
