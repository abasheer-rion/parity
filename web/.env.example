# Copy to .env.local for local development. All values are public (the anon key is safe
# in a browser; row level security decides what anyone can read).
#
# In-app sign-in (auth/README.md). Off unless set to "on".
VITE_APP_AUTH=
# Defaults to the Parity project when empty.
VITE_SUPABASE_URL=
# Needed only when VITE_APP_AUTH=on.
VITE_SUPABASE_ANON_KEY=
