{
  "name": "parity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build --mode site && vite build && vite build --mode sim && vite build --mode trade && npm run seo",
    "seo": "python3 ../scripts/seo/build_public.py --out dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "preview": "vite preview",
    "test": "vitest run",
    "a11y": "node scripts/a11y.mjs",
    "cls": "node scripts/cls.mjs",
    "verify:network": "node scripts/verify-network.mjs",
    "content": "node --experimental-strip-types scripts/content/render.ts",
    "deeplinks": "node scripts/deeplinks.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.17",
    "jose": "^6.2.13",
    "lenis": "^1.3.27",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
