{
  "name": "parity-desktop",
  "productName": "Parity",
  "version": "0.1.1",
  "private": true,
  "description": "Parity for Mac and Windows: the site, Verify, the product app, Research, Parity Terminal and Parity Trade in one window.",
  "author": "Parity Trading, Inc. <contact@paritytrading.ai>",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "web": "npm --prefix ../web run build && node scripts/prepare-web.mjs",
    "icons": "node scripts/icons.mjs",
    "start": "electron .",
    "dev": "PARITY_DEV_URL=http://127.0.0.1:5199 electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "pack": "electron-builder --dir --publish never",
    "shots": "PARITY_SHOTS=1 electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.paritytrading.desktop",
    "productName": "Parity",
    "copyright": "Copyright 2026 Parity Trading, Inc.",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "assets/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/web",
        "to": "web",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Parity link",
        "schemes": [
          "parity"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "abasheer-rion",
        "repo": "parity",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Parity ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 200
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "artifactName": "Parity-${version}-${arch}.dmg"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Parity Setup ${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parity"
    }
  },
  "allowScripts": {
    "electron": true
  }
}
