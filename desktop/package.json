{
  "name": "parity-desktop",
  "productName": "Parity",
  "version": "0.2.2",
  "private": true,
  "description": "Parity for Mac and Windows: the site, Verify, the product app, Research, Parity Terminal and Parity Trade, with windows, workspaces and a menu bar item.",
  "author": "Parity Trading, Inc. <contact@paritytrading.ai>",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "web": "npm --prefix ../web run build && node scripts/prepare-web.mjs",
    "icons": "node scripts/icons.mjs",
    "start": "electron .",
    "dev": "PARITY_DEV_URL=http://127.0.0.1:5199 electron .",
    "test": "node --test tests/*.test.js",
    "test:app": "node scripts/selftest.mjs",
    "soak": "node scripts/soak.mjs",
    "build": "electron-builder --config electron-builder.config.js",
    "build:mac": "electron-builder --config electron-builder.config.js --mac --publish never",
    "build:win": "electron-builder --config electron-builder.config.js --win --publish never",
    "pack": "electron-builder --config electron-builder.config.js --dir --publish never",
    "shots": "PARITY_SHOTS=$HOME/Desktop/parity-app/shots PARITY_SHOTS_STEPS=wall,menu,palette,trade,window2 electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron": true
  }
}
