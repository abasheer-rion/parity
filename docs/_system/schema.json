  },
  "authors": [
    "ayan",
    "amanda",
    "abanish"
  ],
  "style": {
    "banned_characters": {
      "\u2014": "em dash",
      "\u2013": "en dash",
      "\u2018": "curly quote",
      "\u2019": "curly quote",
      "\u201c": "curly quote",
      "\u201d": "curly quote",
      "\u2026": "ellipsis character"
    },
    "banned_words": [
      "delve",
      "seamless",
      "seamlessly",
      "cutting-edge",
      "comprehensive",
      "game-changer",
      "revolutionary",
      "unlock",
      "unleash",
      "supercharge",
      "synergy",
      "groundbreaking",
      "state-of-the-art",
      "in conclusion",
      "it is important to note"
    ],
    "max_line_length": 0
  },
  "layout": {
    "top_level": [
      ".editorconfig",
      ".githooks",
      ".github",
      ".gitignore",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "Makefile",
      "README.md",
      "catalog",
      "docs",
      "engine",
      "ledger",
      "registrations",
      "scripts",
      "supabase",
      "web"
    ],
    "unchecked_markdown": [],
    "generated": [
      "docs/README.md",
      "docs/TAGS.md",
      "docs/RESULTS.md"
    ]
  }
}
