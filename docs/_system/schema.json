{
  "about": "Single source of truth for how docs are organised. Read by scripts/docs.py. Change this file, not the checker, when a rule changes, and record why in a decision.",
  "front_matter_keys": [
    "id",
    "title",
    "type",
    "status",
    "created",
    "updated",
    "authors",
    "tags",
    "related"
  ],
  "types": {
    "intent": {
      "folder": "intent",
      "prefix": "INT",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "current",
        "superseded"
      ],
      "sections": [
        "In plain words",
        "Summary",
        "What we want",
        "What we do not want",
        "How we will know"
      ],
      "about": "Why the project exists. Changed rarely, and only by adding a new intent that supersedes the old one."
    },
    "decision": {
      "folder": "decisions",
      "prefix": "DEC",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ],
      "sections": [
        "In plain words",
        "Context",
        "Decision",
        "Consequences"
      ],
      "about": "One choice we made and why. Never edited after acceptance except to mark it superseded."
    },
    "hypothesis": {
      "folder": "hypotheses",
      "prefix": "HYP",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "open",
        "testing",
        "supported",
        "rejected",
        "parked"
      ],
      "sections": [
        "In plain words",
        "Claim",
        "Why it might be true",
        "Why it might be false",
        "How we test it",
        "Result so far"
      ],
      "about": "A claim about markets that an experiment can support or reject."
    },
    "experiment": {
      "folder": "experiments",
      "prefix": "EXP",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "planned",
        "running",
        "done",
        "abandoned"
      ],
      "sections": [
        "In plain words",
        "Question",
        "Setup",
        "Results",
        "Threats to validity",
        "What we learned",
        "Next"
      ],
      "about": "One run or set of runs, with the exact settings, so anyone can reproduce it."
    },
    "research": {
      "folder": "research",
      "prefix": "RES",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "draft",
        "current",
        "outdated"
      ],
      "sections": [
        "In plain words",
        "Summary"
      ],
      "about": "Reading notes, surveys of papers, code and forums."
    },
    "guide": {
      "folder": "guides",
      "prefix": "GDE",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "draft",
        "current",
        "outdated"
      ],
      "sections": [
        "In plain words",
        "Summary"
      ],
      "about": "How to do something in this repo, step by step."
    },
    "reference": {
      "folder": "reference",
      "prefix": "REF",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "draft",
        "current",
        "outdated"
      ],
      "sections": [
        "In plain words",
        "Summary"
      ],
      "about": "Facts to look up: definitions, data sources, architecture."
    },
    "log": {
      "folder": "log",
      "prefix": "LOG",
      "filename": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "final"
      ],
      "sections": [
        "In plain words",
        "What happened",
        "Decisions",
        "Open questions"
      ],
      "append_only": true,
      "about": "A dated, append-only record of a working session. Corrections go in a new entry, not an edit."
    },
    "algorithm": {
      "folder": "algorithms",
      "prefix": "ALG",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "catalogued",
        "sourced",
        "hypothesis",
        "implemented",
        "registered",
        "official",
        "reproduced",
        "forward",
        "verdict"
      ],
      "sections": [
        "In plain words",
        "Summary",
        "How it works",
        "Reported results",
        "Our research"
      ],
      "generated": true,
      "about": "One report per trading algorithm we know of, generated from catalog/algorithms/. Edit the JSON, not the page."
    },
    "dataset": {
      "folder": "datasets",
      "prefix": "DAT",
      "filename": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*\\.md$",
      "statuses": [
        "in-use",
        "candidate",
        "not-usable"
      ],
      "sections": [
        "In plain words",
        "Summary",
        "Terms and quality"
      ],
      "generated": true,
      "about": "One report per data source, generated from catalog/datasets/. Edit the JSON, not the page."
    }
  },
